{"nodes": [{"id": "docs_future_roadmap", "label": "Roadmap (TX listings -> RX -> details -> optimize)", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_future_in_original_draft", "label": "IN original draft (superseded)", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Immediate pin / indirect dest encoding was not built; silicon IN is OUT-shaped. [1:0]=00 is the expansion joint, spent on a missing 'when', never on a protocol name."}, {"id": "docs_future_rx_sram", "label": "RX SRAM (third 256x8 macro)", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TX already owns dmem; a 1-port SRAM cannot store incoming bytes and fetch payload simultaneously, so a third SRAM is needed (supersedes dmem-from-the-back)."}, {"id": "docs_future_ext_opcode", "label": "EXT opcode (draft, likely 1001)", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same shape as OUT; dumps RX SRAM serially on free pins with Rd as the window, because Tiny Tapeout cannot read SRAM and dumping all uo_out while running produces garbage."}, {"id": "docs_future_rx_pending_table", "label": "RX pending per protocol", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_future_drive_only_vs_sample_buckets", "label": "Drive-only vs protocol-is-a-sample buckets", "file_type": "rationale", "source_file": "docs/future.md", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protocols like I2C ACK, SPI MISO, JTAG TDO, SWD turnaround, PS/2, CAN ACK are pin movies without sampling; drive-only protocols can be stacked without RX."}, {"id": "docs_future_jtag", "label": "JTAG (IEEE 1149.1) plan", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_future_swd", "label": "SWD plan", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_future_ps2", "label": "PS/2 plan", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_future_can", "label": "CAN plan", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_future_two_cores", "label": "Two cores (core0/core1) for independent timebases", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cores lock to their own pins; no matched pcs, no WAIT on the other core (burns power, invents a barrier). Clocked duplex on one core is sticky PSET then IN."}, {"id": "docs_future_compiler_pipeline", "label": "Compiler pipeline (protocol dict -> asm + dmem -> hex)", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NRZI, bit stuffing, CRC, LS/FS polarity are compiler work, keeping silicon dumb; listing holds dmem addresses."}, {"id": "docs_future_non_blocking_in", "label": "Non-blocking IN (thought)", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deferred: 1-bit protocols cannot wait for 8 bits and dest write collides with the 1W RF; build blocking one-bit IN first."}, {"id": "docs_future_badpiggy_protocol", "label": "BADPIGGY protocol (picture painting idea)", "file_type": "concept", "source_file": "docs/future.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_future_rejected_ideas", "label": "Rejected ideas list", "file_type": "rationale", "source_file": "docs/future.md", "source_location": "L118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: protocol-named opcodes, XOR/MOV, PID hardware, auto-detect, 3R2W RF, combo uo_out, lockstep cores, PSET-fused sampling, hardware NRZI, circular imem, OUTD, ALU, protocol-select pin. True programmability is the wow."}], "edges": [{"source": "docs_future_in_original_draft", "target": "docs_isa_in", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/future.md", "source_location": "L9", "weight": 1.0}, {"source": "docs_future_ext_opcode", "target": "docs_future_rx_sram", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/future.md", "source_location": "L47", "weight": 1.0}, {"source": "docs_future_ext_opcode", "target": "docs_isa_out", "relation": "semantically_similar_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/future.md", "source_location": "L47", "weight": 1.0}, {"source": "docs_future_rx_sram", "target": "docs_isa_dmem", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/future.md", "source_location": "L45", "weight": 1.0}, {"source": "docs_future_rx_pending_table", "target": "docs_listings_uart_tx", "relation": 